<UserControl x:Class="BrowserMultiview.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2" LastChildFill="True">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Content="&#x2190;" Width="28" Margin="0,0,2,0"
                    ToolTip="Voltar" IsEnabled="False" Click="BackButton_Click" />
            <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="&#x2715;" Width="28" Margin="2,0,0,0"
                    ToolTip="Remover painel" Click="RemoveButton_Click" />
            <Button x:Name="ZoomButton" DockPanel.Dock="Right" MinWidth="44" Margin="2,0,0,0" Padding="4,0"
                    ToolTip="Zoom do painel (Ctrl + / Ctrl - / Ctrl 0 também funcionam)" Click="ZoomButton_Click" />
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="&#x21BB;" Width="28" Margin="2,0,0,0"
                    ToolTip="Recarregar" Click="ReloadButton_Click" />
            <TextBox x:Name="AddressBox" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" />
        </DockPanel>
        <Grid>
            <wv2:WebView2 x:Name="WebView" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</UserControl>
