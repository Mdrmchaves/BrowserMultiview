<Window x:Class="BrowserMultiview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserMultiview" Height="800" Width="1400">
    <DockPanel>
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
            <Button Content="+ Painel" Padding="8,2" Margin="0,0,4,0" Click="AddPaneButton_Click" />
            <Button Content="Alternar layout" Padding="8,2" Margin="0,0,12,0" Click="ToggleLayoutButton_Click" />
            <CheckBox x:Name="AutoHideCheckBox" Content="Ocultar barras automaticamente" VerticalAlignment="Center"
                      ToolTip="As barras reaparecem ao encostar o mouse na borda de cima da janela ou de um painel"
                      Click="AutoHideCheckBox_Click" />
        </StackPanel>
        <Grid>
            <Grid x:Name="PanesHost" />
            <TextBlock x:Name="EmptyText" Text="Nenhum painel. Clique em &quot;+ Painel&quot; para adicionar."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
